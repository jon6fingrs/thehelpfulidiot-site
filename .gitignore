# ---------------------------------------------------------------- build output
# Regenerated by every `zola build`; never commit.
/public/
.zola-cache/
/static/processed_images/

# ------------------------------------------------------------ deployment config
# Server-specific: internal Plausible hostname, obfuscated tracker path.
# Back these up somewhere other than git.
nginx.conf
nginx.conf.*
docker-compose.override.yml
compose.override.yml

# ------------------------------------------------------------------ secrets
# Nothing in this repo needs credentials. If something ever does, keep it in
# one of these and it stays local.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/
*credentials*
*.htpasswd

# -------------------------------------------------- migration / backup leftovers
# Root-level only (leading slash): site downloads under static/ are unaffected.
/*.sql
/*.sql.gz
/*.tar.gz
/*.tgz
/*.zip
/wp-export/
/zola-content/
*.log
*.bak
*.orig

# ------------------------------------------------------- editor / OS noise
.DS_Store
Thumbs.db
*.swp
*~
.vscode/
.idea/
.direnv/
result
node_modules/
